# Engine: duckdb (local, default) or snowflake
SCDW_ENGINE=duckdb
SCDW_DUCKDB_PATH=data/scdw.duckdb

# Snowflake (CLI runs; Airflow uses the snowflake_default connection instead)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_SCDW_AIRFLOW
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SCDW_LOADER
SNOWFLAKE_WAREHOUSE=SCDW_WH
SNOWFLAKE_DATABASE=SUPPLY_CHAIN_DW

# Power BI refresh (service principal)
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=
PBI_DATASET_ID=
